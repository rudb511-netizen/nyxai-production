# NYX production email — Gmail SMTP
# Copy these keys into the deployment environment. Do not commit real secrets.
# SMTP_PASS must be the existing Gmail app password already configured for
# nyx.officialsupport@gmail.com. Never put the real password in this file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nyx.officialsupport@gmail.com
SMTP_PASS=YOUR_EXISTING_SMTP_PASSWORD

PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# Optional. Jamendo client id for full-length CC tracks (mp3).
# Register at https://devportal.jamendo.com/ — never commit the secret if you add one.
JAMENDO_CLIENT_ID=

# AI providers. Set these in the server environment only. Never commit real keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
RUNWAY_API_KEY=
AI_FALLBACK_ORDER=openrouter,gemini,mistral,openai
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-lite-latest
MISTRAL_MODEL=mistral-small-latest
RUNWAY_MODEL=gen4.5

